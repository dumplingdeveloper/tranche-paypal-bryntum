{
  "name": "tranche",
  "version": "0.1.0",
  "private": true,
  "description": "Tranche: agent-driven delivery board where PayPal invoice tranches drive a Bryntum Gantt.",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@bryntum/calendar": "npm:@bryntum/calendar-trial@7.3.7",
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@7.3.7",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@github/copilot-sdk": "1.0.15",
    "@paypal/paypal-server-sdk": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test test/unit/*.test.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/e2e/*.e2e.ts",
    "test:live": "TRANCHE_LIVE=1 TRANCHE_SHOT_DIR=artifacts/screenshots/live TRANCHE_EVIDENCE_DIR=artifacts/live EXPECTED_GITHUB_LOGIN=${EXPECTED_GITHUB_LOGIN:-yuxinshiu63} node --disable-warning=ExperimentalWarning --test --test-timeout=900000 test/live/*.live.ts",
    "test:sandbox-live": "LIVE_PAYPAL=1 TRANCHE_PAYPAL_CALL_LOG=${TRANCHE_PAYPAL_CALL_LOG:-artifacts/sandbox/paypal-calls.jsonl} TRANCHE_SHOT_DIR=artifacts/screenshots/sandbox TRANCHE_EVIDENCE_DIR=artifacts/sandbox node --disable-warning=ExperimentalWarning --test --test-timeout=600000 test/sandbox-live/*.sandbox.ts",
    "test:sandbox-remind": "LIVE_PAYPAL_REMIND=1 TRANCHE_PAYPAL_CALL_LOG=${TRANCHE_PAYPAL_CALL_LOG:-artifacts/sandbox/paypal-calls.jsonl} TRANCHE_SHOT_DIR=artifacts/screenshots/sandbox TRANCHE_EVIDENCE_DIR=artifacts/sandbox node --disable-warning=ExperimentalWarning --test --test-timeout=300000 test/sandbox-live/remind.sandbox.ts",
    "probe:trial-clock": "node --disable-warning=ExperimentalWarning scripts/trial-clock-probe.ts",
    "test:byok": "node --disable-warning=ExperimentalWarning --test test/byok/*.local.ts",
    "sandbox:seed": "node --disable-warning=ExperimentalWarning scripts/sandbox-seed.ts",
    "sandbox:smoke": "node --disable-warning=ExperimentalWarning scripts/sandbox-smoke.ts",
    "sandbox:use-public-creds": "node --disable-warning=ExperimentalWarning scripts/sandbox-use-public-creds.ts",
    "sandbox:probe": "node --disable-warning=ExperimentalWarning scripts/sandbox-probe.ts"
  }
}
